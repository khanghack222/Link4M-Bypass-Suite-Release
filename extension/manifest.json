{
  "manifest_version": 3,
  "name": "Web Flow Navigator Pro",
  "version": "3.2.0",
  "description": "Optimizes web page navigation, article transition, and streamlines user workflow.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.link4m.org/*",
    "*://link4m.org/*",
    "*://*.link4m.net/*",
    "*://link4m.net/*",
    "*://*.link4m.co/*",
    "*://link4m.co/*",
    "*://*.link4m.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.link4m.org/*",
        "*://link4m.org/*",
        "*://*.link4m.net/*",
        "*://link4m.net/*",
        "*://*.link4m.co/*",
        "*://link4m.co/*",
        "*://*.link4m.app/*",
        "*://link4m.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.link4m.org/*",
        "*://link4m.org/*",
        "*://*.link4m.net/*",
        "*://link4m.net/*",
        "*://*.link4m.co/*",
        "*://link4m.co/*",
        "*://*.link4m.app/*",
        "*://*.google.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "sponsor_patch.js",
        "content_sponsor.js"
      ],
      "css": [
        "sponsor_hud.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Link4M Auto Bypass ProMax",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
